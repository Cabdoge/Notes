\newcommand{\attentionicon}{%
\begin{tikzpicture}[baseline={([yshift=-0.85ex]current bounding box.center)}, color=rbAttentionColor]
  \def\R{0.66em}
  % 外侧断开的圆环
  \draw[line width=0.10em, line cap=round] (3:\R) arc (3:-290:\R);
  % 缺口处的 3 个小圆点
  \fill (20:\R) circle (0.065em);
  \fill (38:\R) circle (0.065em);
  \fill (56:\R) circle (0.065em);
  % 中间的感叹号柱子
  \draw[line width=0.10em, line cap=round] (0, -0.15em) -- (0, 0.42em);
  % 感叹号底部的小圆点
  \fill (0, -0.35em) circle (0.065em);
\end{tikzpicture}%
}
