% 编码：UTF-8)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rainbow}[2026/03/04 (1.0)Rainbow theorem environments (tcolorbox)]

%================ 依赖宏包 ================
\RequirePackage{xcolor}
