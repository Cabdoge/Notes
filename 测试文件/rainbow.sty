%================ 附加：proof 环境 ================
% 若未加载 amsthm，则提供一个简单的 proof 环境
\@ifundefined{proof}{%
  \newenvironment{proof}[1][证明]{%
    \par\noindent\textbf{#1.}\quad\ignorespaces
  }{%
    \hfill$\square$\par\medskip
  }
}{}

%================ 附加：remark / example（无编号，灰色边框）================
\newtcolorbox{remark}[1][]{%
  enhanced, breakable, blanker, colback=white,
  borderline west={3.5pt}{0pt}{gray!60},
  left=1em, right=0pt, top=.75em, bottom=.75em,
  before skip=.5em, after skip=.5em,
  fonttitle=\bfseries\color{gray!60},
  attach title to upper={\par\vspace{.3em}},
  title={注记},
  #1,
}

\newtcolorbox{example}[1][]{%
  enhanced, breakable, blanker, colback=white,
  borderline west={3.5pt}{0pt}{gray!60},
  left=1em, right=0pt, top=.75em, bottom=.75em,
  before skip=.5em, after skip=.5em,
  fonttitle=\bfseries\color{gray!60},
  attach title to upper={\par\vspace{.3em}},
  title={例},
  #1,
}

\endinput
