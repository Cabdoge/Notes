% rainbow.sty
% Typst theorion/rainbow 主题的 LaTeX 移植版
% 提供带彩色左边框的定理类环境
% 编码：UTF-8
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rainbow}[2026/03/04 v1.0 Rainbow theorem environments (tcolorbox)]

%================ 依赖宏包 ================
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable, theorems}
\RequirePackage{amssymb}       % 数学符号
\RequirePackage{amsmath}

%================ 颜色定义 ================
% 对应 Typst 中各环境的颜色（darken 处理后的近似值）
\definecolor{rbTheoremColor}{RGB}{178,34,34}      % red.darken(20%)
\definecolor{rbLemmaColor}{RGB}{0,115,115}         % teal.darken(10%)
\definecolor{rbCorollaryColor}{RGB}{178,34,178}    % fuchsia.darken(10%)
\definecolor{rbDefinitionColor}{RGB}{230,140,0}    % orange
\definecolor{rbAxiomColor}{RGB}{0,102,0}           % green.darken(20%)
\definecolor{rbPostulateColor}{RGB}{128,0,0}       % maroon
\definecolor{rbPropositionColor}{RGB}{0,60,179}    % blue.darken(10%)
\definecolor{rbAssumptionColor}{RGB}{115,0,153}    % purple.darken(10%)
\definecolor{rbPropertyColor}{RGB}{0,115,140}      % eastern.darken(10%)
\definecolor{rbConjectureColor}{RGB}{0,0,102}      % navy.darken(10%)

%================ 独立计数器（每个环境各自编号，均按 section 重置） ================
\newcounter{rbtheorem}[section]
\renewcommand{\therbtheorem}{\thesection.\arabic{rbtheorem}}

\newcounter{rblemma}[section]
\renewcommand{\therblemma}{\thesection.\arabic{rblemma}}

\newcounter{rbcorollary}[section]
\renewcommand{\therbcorollary}{\thesection.\arabic{rbcorollary}}

\newcounter{rbdefinition}[section]
\renewcommand{\therbdefinition}{\thesection.\arabic{rbdefinition}}

\newcounter{rbaxiom}[section]
\renewcommand{\therbaxiom}{\thesection.\arabic{rbaxiom}}

\newcounter{rbpostulate}[section]
\renewcommand{\therbpostulate}{\thesection.\arabic{rbpostulate}}

\newcounter{rbproposition}[section]
\renewcommand{\therbproposition}{\thesection.\arabic{rbproposition}}

\newcounter{rbassumption}[section]
\renewcommand{\therbassumption}{\thesection.\arabic{rbassumption}}

\newcounter{rbproperty}[section]
\renewcommand{\therbproperty}{\thesection.\arabic{rbproperty}}

\newcounter{rbconjecture}[section]
\renewcommand{\therbconjecture}{\thesection.\arabic{rbconjecture}}

%================ 定义各环境 ================

% ---- theorem 定理 ----
\newtcolorbox[use counter=rbtheorem]{theorem}[2][]{%
  enhanced, breakable, blanker, colback=white,
  borderline west={3.5pt}{0pt}{rbTheoremColor},
  left=1em, right=0pt, top=.75em, bottom=.75em,
  before skip=.5em, after skip=.5em,
  fonttitle=\bfseries\color{rbTheoremColor},
  attach title to upper={\par\vspace{.3em}},
  title={定理~\therbtheorem%
    \ifx\\#2\\\else~(#2)\fi
  },
  #1,
}

% ---- lemma 引理 ----
\newtcolorbox[use counter=rblemma]{lemma}[2][]{%
  enhanced, breakable, blanker, colback=white,
  borderline west={3.5pt}{0pt}{rbLemmaColor},
  left=1em, right=0pt, top=.75em, bottom=.75em,
  before skip=.5em, after skip=.5em,
  fonttitle=\bfseries\color{rbLemmaColor},
  attach title to upper={\par\vspace{.3em}},
  title={引理~\therblemma%
    \ifx\\#2\\\else~(#2)\fi
  },
  #1,
}

% ---- corollary 推论 ----
\newtcolorbox[use counter=rbcorollary]{corollary}[2][]{%
  enhanced, breakable, blanker, colback=white,
  borderline west={3.5pt}{0pt}{rbCorollaryColor},
  left=1em, right=0pt, top=.75em, bottom=.75em,
